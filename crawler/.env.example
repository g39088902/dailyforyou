# 爬虫定时调度间隔（分钟，Daemon 模式生效，默认 2 小时）
CRAWL_INTERVAL_MINUTES=120

# 上游请求超时（毫秒）
REQUEST_TIMEOUT=6000

# 是否写日志文件到 ./logs
USE_LOG_FILE=true

# 抓取后是否写入新闻库（news_items）
NEWS_PERSIST_ENABLED=true

# 翻译用 DeepSeek 配置
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# 远程数据库（与用户服务共用一个实例；留空则使用本地 SQLite）
LIBSQL_URL=""
LIBSQL_AUTH_TOKEN=""

# 本地 SQLite 路径（LIBSQL_URL 为空时生效）
SQLITE_DB_PATH="./data/news.sqlite"

# 服务端口
PORT=6688

# 跨域与访问控制
ALLOWED_DOMAIN="*"
ALLOWED_HOST=""

# 是否禁止爬虫抓取本站
DISALLOW_ROBOT=true

# 缓存时长（秒）
CACHE_TTL=3600

# 上游请求超时（毫秒）
REQUEST_TIMEOUT=6000

# 是否写日志文件到 ./logs
USE_LOG_FILE=true

# 是否全局输出 RSS
RSS_MODE=false

# 抓取后是否写入新闻库（news_items）
NEWS_PERSIST_ENABLED=true

# 翻译用 DeepSeek 配置
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# 远程数据库（与用户服务共用一个实例；留空则使用本地 SQLite）
LIBSQL_URL=""
LIBSQL_AUTH_TOKEN=""

# 本地 SQLite 路径（LIBSQL_URL 为空时生效）
SQLITE_DB_PATH="./data/news.sqlite"

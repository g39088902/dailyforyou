# 服务端口
PORT=6690

# 允许的域名
ALLOWED_DOMAIN="*"

# 允许的主域名，填写格式为 imsyy.top
## 若填写该项，将忽略 ALLOWED_DOMAIN
ALLOWED_HOST=""

# 是否输出日志
USE_LOG_FILE=true

# DeepSeek API 配置
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# 远程数据库连接配置 (sqld / libSQL，留空则使用本地 SQLite)
LIBSQL_URL=""
LIBSQL_AUTH_TOKEN=""

# 本地 SQLite 路径（LIBSQL_URL 为空时生效）
SQLITE_DB_PATH="./data/scores.sqlite"

# ===== 鉴权与多用户 =====
# JWT 签名密钥，生产必填，可用 openssl rand -hex 32 生成
AUTH_JWT_SECRET=""
# 登录令牌有效期（秒），默认 7 天
AUTH_JWT_TTL=604800
# 钱包签名挑战有效期（秒）
AUTH_NONCE_TTL=300
# 登录消息中的域名与 URI，留空则回退 ALLOWED_HOST / localhost
AUTH_DOMAIN=""
AUTH_URI=""
# 每 IP/地址 每分钟可申请的 nonce 数量
AUTH_RATE_LIMIT_PER_MIN=10

# 默认账户（承接历史单用户数据），迁移后把该钱包地址绑定上去即可登录查看
DEFAULT_USER_ID=1
DEFAULT_USER_ADDRESS=""

# ===== 评分与 Prompt =====
# 用户自定义 Prompt 的长度上限
SCORE_PROMPT_MAX_LENGTH=20000
# 每个用户每分钟评分请求上限（含缓存查询，作为滥用防护）
SCORE_RATE_LIMIT_PER_MIN=240
# Prompt 试跑频率（次/分钟）
PROMPT_TEST_RATE_LIMIT_PER_MIN=5

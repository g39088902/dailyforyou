# 服务端口
PORT=6690

# 允许的域名
ALLOWED_DOMAIN="*"

# 允许的主域名，填写格式为 imsyy.top
## 若填写该项，将忽略 ALLOWED_DOMAIN
ALLOWED_HOST=""

# 是否输出日志
USE_LOG_FILE=true

# DeepSeek API 配置
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"

# ===== 评分调用的推理参数 =====
# 策略：准确性优先，默认走最高档思考（max），成本其次。
# 降档前必须补齐「同档位重复调用的自一致性基线 + 32 条 A/B 对比」，确认准确率基本不掉再改。
DEEPSEEK_THINKING="enabled"
# 思考强度：none / low / high / max，留空=不下发；thinking=disabled 时忽略（none 除外）
DEEPSEEK_REASONING_EFFORT="max"
# 输出 token 上限（含思考 token）；0=不下发（思考默认 64K、非思考默认 8K）
# max 档实测单条峰值约 1.1K，8192 留足余量避免截断导致 JSON 解析失败
DEEPSEEK_MAX_TOKENS=8192
# 采样温度
DEEPSEEK_TEMPERATURE=0.1
# 是否要求 JSON 模式：自定义 Prompt 未要求输出 JSON 时可能导致空输出，默认关闭
DEEPSEEK_JSON_MODE=false

# 远程数据库连接配置 (sqld / libSQL，留空则使用本地 SQLite)
LIBSQL_URL=""
LIBSQL_AUTH_TOKEN=""

# 本地 SQLite 路径（LIBSQL_URL 为空时生效）
SQLITE_DB_PATH="./data/scores.sqlite"

# ===== 鉴权与多用户 =====
# JWT 签名密钥，生产必填，可用 openssl rand -hex 32 生成
AUTH_JWT_SECRET=""
# 登录令牌有效期（秒），默认 7 天
AUTH_JWT_TTL=604800
# 钱包签名挑战有效期（秒）
AUTH_NONCE_TTL=300
# 登录消息中的域名与 URI，留空则回退 ALLOWED_HOST / localhost
AUTH_DOMAIN=""
AUTH_URI=""
# 每 IP/地址 每分钟可申请的 nonce 数量
AUTH_RATE_LIMIT_PER_MIN=10

# 默认账户（承接历史单用户数据），迁移后把该钱包地址绑定上去即可登录查看
DEFAULT_USER_ID=1
DEFAULT_USER_ADDRESS=""

# ===== 评分与 Prompt =====
# 用户自定义 Prompt 的长度上限
SCORE_PROMPT_MAX_LENGTH=20000
# 每个用户每分钟评分请求上限（含缓存查询，作为滥用防护）
SCORE_RATE_LIMIT_PER_MIN=240
# Prompt 试跑频率（次/分钟）
PROMPT_TEST_RATE_LIMIT_PER_MIN=5
